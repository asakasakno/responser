{
  "manifest_version": 3,
  "name": "응대도우미 - AI 답변 생성",
  "version": "1.0.0",
  "description": "리뷰, 문의, 클레임 답변을 AI로 빠르게 생성하세요",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
