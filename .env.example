# =====================================================
# 응대도우미 - 환경변수 예시 파일
# 실제 값은 절대 커밋하지 마세요. placeholder만 포함되어 있습니다.
# Lovable Cloud 환경에서는 .env가 자동 생성/관리됩니다.
# =====================================================

# ---------- Client (브라우저 노출 OK) ----------
# Vite의 VITE_ prefix가 붙은 값만 클라이언트 번들에 포함됩니다.
# 아래 키들은 공개 키(anon/publishable)로, RLS로 보호됩니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# (선택) Sentry 프론트엔드 DSN — production 빌드에서만 활성화됨.
# 비워두면 Sentry 자체가 init되지 않음 (개발/스테이징 모두 비활성).
VITE_SENTRY_DSN=

# =====================================================
# 아래 값들은 절대 VITE_ prefix를 붙이지 마세요.
# Edge Function / 서버 환경변수로만 사용됩니다.
# Supabase 시크릿 매니저(또는 배포 환경 변수)에 저장하세요.
# =====================================================

# Supabase 관리자 키 (service_role) — 서버 전용
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS=

# Toss Payments
# CLIENT_KEY는 toss-config Edge Function을 통해서만 프론트에 전달됩니다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Lovable AI Gateway (OpenAI / Gemini 모델 호출용)
LOVABLE_API_KEY=

# 카카오 로그인
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 베타 신청 인입용 시크릿 (HEADER 'x-beta-import-secret' 로만 전송)
BETA_IMPORT_SECRET=

# (선택) Sentry 서버 사이드 토큰 — release 업로드 등에만 사용
# SENTRY_AUTH_TOKEN=
